{
  "name": "redpro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:env": "node scripts/check-env.mjs",
    "db:new": "node scripts/db-new.mjs",
    "db:target": "node --env-file-if-exists=.env.development.local --experimental-strip-types scripts/db.ts target",
    "db:check": "node --env-file-if-exists=.env.development.local --experimental-strip-types scripts/db.ts check",
    "db:status": "node --env-file-if-exists=.env.development.local --experimental-strip-types scripts/db.ts status",
    "db:up": "node --env-file-if-exists=.env.development.local --experimental-strip-types scripts/db.ts up",
    "db:down": "node --env-file-if-exists=.env.development.local --experimental-strip-types scripts/db.ts down",
    "test:db": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:ui": "node scripts/test-ui.mjs",
    "codespace:setup": "bash scripts/codespace.sh setup",
    "test:db:disposable": "bash scripts/codespace.sh test-db",
    "db:inspect:private": "bash scripts/codespace.sh inspect",
    "db:inspect:admin": "node --experimental-strip-types scripts/codespace-admin.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "client-only": "0.0.1",
    "kysely": "0.29.7",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
