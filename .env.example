# RedPro - RED-004
# All values are intentionally empty. No external service is required for the home page.
# Copy to .env.local only when configuring local development; never commit real values.
# See docs/ENVIRONMENT.md for scope, validation and Vercel configuration.

# Optional public Supabase configuration: configure both together or leave both empty.
# These values may be included in the browser bundle; never use a private key here.
# URL: HTTPS origin of your own project (HTTP accepted only for loopback development).
NEXT_PUBLIC_SUPABASE_URL=
# Only the public sb_publishable_ format is accepted by the prepared clients.
# Never use sb_secret_, service_role, passwords or provider API keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional standalone HTTP smoke test target; default is http://127.0.0.1:3000.
# The Node script does not load .env.local automatically; export this in the process
# or explicitly use: node --env-file=.env.local scripts/smoke.mjs
SMOKE_BASE_URL=

# Private PostgreSQL configuration for RED-011/012. Never prefix with NEXT_PUBLIC_.
# Use ONLY the confirmed development project; never production credentials.
# Scripts explicitly load .env.development.local (ignored by Git).
DATABASE_URL=
# Optional separate raw password, avoiding manual URL encoding. Leave the URL's
# password empty when using this; never configure two different password sources.
REDPRO_DB_PASSWORD=
# Optional: password (default) or temporary, after separately authorized Supabase setup.
# Shared Session pooler temporary access uses a fixed jit=on startup option.
REDPRO_DB_AUTH_MODE=
# development for Supabase; test is restricted to a disposable loopback redpro_test DB.
REDPRO_DB_ENV=
# Public project ref, must match the connection destination; local-test for CI.
REDPRO_DB_TARGET_REF=
# Optional path to the public root CA downloaded from the project's SSL settings.
# Remote TLS always verifies certificates and hostnames; never disable verification.
REDPRO_DB_SSL_CA_FILE=

# Optional server-only AI. Leave empty until separate activation and cost approval.
# No AI request runs unless all controls are configured. See docs/AI_CHAT.md.
MINEPRO_AI_ENABLED=
AI_GATEWAY_API_KEY=
MINEPRO_AI_MODEL=
MINEPRO_AI_BUDGET_APPROVED=
MINEPRO_AI_REDIS_URL=
MINEPRO_AI_REDIS_TOKEN=
MINEPRO_AI_RATE_SECRET=
