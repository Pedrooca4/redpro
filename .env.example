# RED-001 starts without Supabase. Leave both values empty until configuring it.
# Copy this file to .env.local; never commit .env.local or real credentials.
# Get the project URL and publishable key from your Supabase project.
# Only sb_publishable_ keys are accepted. Never use secret/service_role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
