{
  "name": "MinePRO — Kysely preparation",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "dockerDashComposeVersion": "none",
      "installDockerBuildx": false
    }
  },
  "remoteUser": "node",
  "postCreateCommand": "bash scripts/codespace.sh setup",
  "forwardPorts": [],
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "remoteEnv": { "NEXT_TELEMETRY_DISABLED": "1" },
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
